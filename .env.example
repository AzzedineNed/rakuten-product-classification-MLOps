# Copy this file to ".env" and fill in your own values.
# .env is gitignored and must NEVER be committed.

# ENS Challenge Data credentials (used by: collect.py --from-ens)
ENS_USERNAME=your_ens_username
ENS_PASSWORD=your_ens_password

# Optional overrides (defaults shown)
# ENS_CHALLENGE_ID=35
# RAKUTEN_CLASSIFIER=mlp

# Grafana admin login (used by: docker compose service `grafana`).
# GRAFANA_ADMIN_PASSWORD has NO default on purpose - compose refuses to start
# without it rather than falling back to Grafana's admin/admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<choose a password>
# Only needed if you reach the stack by LAN IP instead of localhost:
# GRAFANA_ROOT_URL=http://192.168.1.50/grafana/
# PROMETHEUS_EXTERNAL_URL=http://192.168.1.50/prometheus/

MLFLOW_TRACKING_URI=https://dagshub.com/azzedinenedjai95/rakuten-product-classification-MLOps.mlflow
MLFLOW_TRACKING_USERNAME=azzedinenedjai95
MLFLOW_TRACKING_PASSWORD=<your default DagsHub token>
