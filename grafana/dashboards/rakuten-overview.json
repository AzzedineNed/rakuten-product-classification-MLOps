{
  "uid": "rakuten-overview",
  "title": "Rakuten — services overview",
  "description": "Request rate, latency, predictions and fusion health for the image, text and fusion services.",
  "tags": [
    "rakuten",
    "mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "1 = Prometheus reached the service's /metrics. Says nothing about whether a model is loaded — see the serving table.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=~\"image-api|text-api|gateway\"}",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "L"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Which model is each service serving?",
      "description": "THE answer to 'which model is in production'. Read from the running process, not inferred from disk. image stays 'not-loaded' until its first real /predict — the service resolves its model lazily.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "rakuten_model_info",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "S"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Traffic and latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Includes Prometheus's own /metrics scrapes, which is a steady baseline of about 1/15s per service.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(rakuten_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "S"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 latency",
      "description": "Buckets run to 120s because the image service's first /predict imports torch and may resolve a registry version.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(rakuten_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{service}} p95",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "N"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5xx rate",
      "description": "Flat zero is the expected state. Handler exceptions are recorded here even though the 500 itself is produced above the middleware.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(rakuten_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "H"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Predictions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "table",
      "title": "Predictions by product type (top 10)",
      "description": "Cumulative since each service STARTED — these counters are in-process and reset when a container is recreated. A single class dominating is the signal worth watching: the text model's weak classes (1180, 10, 1280) are where drift would show first.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (prdtypecode) (rakuten_predictions_total))",
          "legendFormat": "{{prdtypecode}}",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "G"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prediction rate by service",
      "description": "The text service counts one per PRODUCT, so a batch of 50 moves this by 50, not 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(rakuten_predictions_total[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "Q"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Fusion gateway",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "Fusion outcomes",
      "description": "degraded=true means a modality was asked for and could not be delivered. The measured fusion score (0.7973 weighted F1) applies ONLY to fused=true rows.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (modalities, fused, degraded) (rakuten_fusion_requests_total)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "Q"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Upstream failures",
      "description": "Non-zero here with the gateway still returning 200 means it is silently serving one modality.",
      "datasource": {
        "type": "prometheus",
        "uid": "rakuten-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "rakuten-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (upstream) (rate(rakuten_upstream_failures_total[$__rate_interval]))",
          "legendFormat": "{{upstream}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "X"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
