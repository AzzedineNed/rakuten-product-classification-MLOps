# Data & artifacts (never commit these)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*
reports/*
!reports/.gitkeep

# DVC internals: .dvc/.gitignore (written by DVC) already ignores
# config.local (token), tmp/ and cache/. .dvc/config MUST be committed
# so teammates get the remote definition and `dvc pull` works.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Airflow: secrets and runtime state. NOTE the bare `.env` above does NOT match
# `airflow/.env.airflow` - that pattern only matches a file named exactly .env.
airflow/.env.airflow
airflow/logs/
airflow/plugins/
airflow/config/

# Tooling
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Nginx basic-auth credentials (create locally: see nginx/default.conf header)
nginx/.htpasswd
/models
mlruns/

# MLflow test debris. mlruns/ above covers the artifact store; this is the
# tracking store, which MLflow 3.14.0 creates in the CWD when no tracking URI
# is set at all (its default is sqlite:///<cwd>/mlflow.db, not ./mlruns).
mlflow.db
