# Airflow stack settings - copy to airflow/.env.airflow and fill in.
#   cp airflow/.env.airflow.example airflow/.env.airflow
#
# This file is SEPARATE from the repo root .env on purpose. The root .env holds
# the DagsHub token (MLflow + DVC credential); the orchestrator has no use for
# it, so it does not get it. Airflow receives only what it needs.
#
# airflow/.env.airflow is gitignored. NEVER commit the filled-in version.

# Host UID: NOT set here. `user: "${AIRFLOW_UID:-50000}:0"` in the compose file
# is interpolated by Compose while it PARSES the file, and at that point Compose
# reads only your shell environment and the repo root .env - never a service's
# env_file. Putting AIRFLOW_UID here silently does nothing: the containers fall
# back to 50000 and every file they write into airflow/dags, logs, config and
# plugins ends up owned by 50000, which you then cannot write to.
# It belongs in the ROOT .env instead (it is not a secret):
#   grep -q '^AIRFLOW_UID=' .env || echo "AIRFLOW_UID=$(id -u)" >> .env

# Airflow UI login (http://localhost:8080). Change these.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Encrypts Connection/Variable secrets in the metadata DB. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leaving it empty works for a first boot but leaves stored secrets unencrypted.
FERNET_KEY=

# Signs internal Airflow API tokens. Any long random string; change it.
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-something-random

# Credentials the DAG uses to call the image API through nginx - these are the
# nginx basic-auth credentials from nginx/.htpasswd, NOT the DagsHub token.
RAKUTEN_API_BASE_URL=http://host.docker.internal
RAKUTEN_API_USER=admin
RAKUTEN_API_PASSWORD=

# Both DAGs use the credentials above. The text DAG reaches the text service
# through the /text prefix on the same nginx; override only if that changes.
#RAKUTEN_TEXT_PREFIX=/text
# Optional timeout overrides. Defaults: image train 10800s, image evaluate 900s,
# text train 1800s, text evaluate 600s, poll interval 15s. The text defaults are
# generous against a measured ~2 minute run.
#RAKUTEN_TEXT_TRAIN_TIMEOUT_S=1800
#RAKUTEN_TEXT_EVALUATE_TIMEOUT_S=600
